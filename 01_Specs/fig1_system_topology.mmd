    CAN_BUS --> DEV_DRIVER
    IMU_ADC --> ADC_PULSE
    DEV_DRIVER --> FOC_PULSE
    ADC_PULSE --> FOC_PULSE
    FOC_PULSE --> CLARKE_PARK
    CLARKE_PARK --> THERMAL_MODEL
    THERMAL_MODEL --> DAMP_GUARD
    DAMP_GUARD --> SVPWM_GEN
    SVPWM_GEN --> MOTOR_HW
    FOC_PULSE --> ZDR_GATEWAY
    FOC_PULSE --> TELEMETRY_STREAM
