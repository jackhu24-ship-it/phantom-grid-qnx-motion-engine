graph TD
    subgraph HW_LAYER ["1. Automotive Chassis & Sensor Hardware"]
        CAN_BUS["CAN-FD Bus (64-Byte Payload @ 5 Mbps)"]
        IMU_ADC["Chassis ADC Telemetry & 6-DOF IMU (1000Hz)"]
